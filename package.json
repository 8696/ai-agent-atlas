{
  "name": "atlas-agent",
  "private": true,
  "version": "0.1.0",
  "description": "Atlas - 跑在本地的通用型 AI Agent（LangGraph.js 编排）",
  "type": "module",
  "engines": {
    "node": ">=22.4.0",
    "yarn": ">=1.22.0"
  },
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"yarn dev:backend\" \"yarn dev:frontend\"",
    "dev:backend": "yarn migrate && tsx watch src/server.ts",
    "dev:frontend": "vite",
    "build": "yarn build:backend && yarn build:frontend",
    "build:backend": "tsc -p tsconfig.build.json",
    "build:frontend": "vite build",
    "preview": "vite preview",
    "start": "node dist/src/server.js",
    "migrate": "tsx scripts/migrate.ts",
    "migrate:undo": "tsx scripts/migrate.ts --undo",
    "tool:logs": "tsx scripts/tool-logs.ts",
    "backup": "tsx scripts/backup.ts",
    "seed": "tsx scripts/seed.ts",
    "env:sync": "tsx scripts/sync-env.ts",
    "env:check": "tsx scripts/sync-env.ts --check",
    "test": "vitest run --config vitest.config.ts --passWithNoTests",
    "test:unit": "vitest run --config vitest.config.ts --project unit --passWithNoTests",
    "test:integration": "vitest run --config vitest.config.ts --project integration --passWithNoTests",
    "test:related": "vitest related --config vitest.config.ts",
    "test:changed": "vitest run --config vitest.config.ts --changed --passWithNoTests",
    "test:e2e": "playwright test",
    "test:all": "yarn check && yarn test && yarn test:e2e",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write --no-error-on-unmatched-pattern \"src/**/*.ts\" \"web/**/*.{ts,tsx}\" \"shared/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.ts\" \"*.ts\" \"*.js\" \"*.json\" \"docs/**/*.md\"",
    "format:check": "prettier --check --no-error-on-unmatched-pattern \"src/**/*.ts\" \"web/**/*.{ts,tsx}\" \"shared/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.ts\" \"*.ts\" \"*.js\" \"*.json\" \"docs/**/*.md\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "check": "concurrently -n tsc,lint -r \"yarn typecheck\" \"yarn lint\""
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.161",
    "@ant-design/icons": "^6.3.4",
    "@koa/cors": "^5.0.0",
    "@koa/router": "^15.7.0",
    "@langchain/anthropic": "^1.6.0",
    "@langchain/core": "^1.3.2",
    "@langchain/langgraph": "^1.5.3",
    "@langchain/mcp-adapters": "^2.0.1",
    "@langchain/openai": "^1.8.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ai": "^7.0.157",
    "antd": "^6.6.8",
    "axios": "^1.21.0",
    "dayjs": "^1.11.23",
    "dotenv": "^18.0.9",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "highlight.js": "^11.12.0",
    "koa": "^3.2.1",
    "koa-body": "^8.0.1",
    "koa-bodyparser": "^4.4.1",
    "nanoid": "^6.0.2",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.5",
    "reflect-metadata": "^0.2.2",
    "sequelize": "^6.37.8",
    "sequelize-typescript": "^2.1.6",
    "sqlite3": "^6.0.1",
    "umzug": "^3.8.3",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@types/koa": "^3.0.3",
    "@types/koa-bodyparser": "^4.3.13",
    "@types/koa__cors": "^5.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/ui": "^5.0.5",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript7": "npm:typescript@^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
