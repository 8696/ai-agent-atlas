# ── 服务 ────────────────────────────────────────────────
# development | test | production
NODE_ENV=development
# 后端端口
PORT=3000
# ⚠️ 默认只听本机。要局域网访问再改（改了要在 UI 上提示风险）
HOST=127.0.0.1

# ── 存储 ────────────────────────────────────────────────
# 业务库（SQLite）
DATABASE_PATH=data/atlas.db
# 向量库（sqlite-vec，独立文件）
VECTOR_DB_PATH=data/vectors.db
# Agent 能碰到的目录根（路径沙箱的基准）
WORKSPACE_ROOT=data/workspace

# ── 模型（平台默认） ────────────────────────────────────
# anthropic | openai
LLM_PROVIDER=anthropic
# 兼容端点地址；留空 = 供应商默认
LLM_BASE_URL=
# ⚠️ 留空（.env.example 里不写真值）
LLM_API_KEY=
LLM_MODEL=

# ── 安全 ────────────────────────────────────────────────
# ⚠️ 必填，至少 16 位；不配则启动失败
JWT_SECRET=
# 加密模型 API Key 用的密钥；不配则不能保存模型 Key
CONFIG_ENCRYPTION_KEY=
# 允许 HTTP 工具指向私网 / 回环（默认禁止）
ALLOW_PRIVATE_EGRESS=false

# ── 预算 ────────────────────────────────────────────────
# 默认月度 token 预算
DEFAULT_TOKEN_BUDGET=200000
# 超预算是否硬拦（默认只告警）
COST_BUDGET_BLOCK=false

# ── 日志 ────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=info
