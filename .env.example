# ── 服务 ────────────────────────────────────────────────
# development | test | production
NODE_ENV=development
# 后端端口
PORT=3100
# ⚠️ 默认只听本机。改成非回环（如 0.0.0.0）时，启动日志会打红色告警：
#    局域网内任何人都能用本 Agent 执行命令
HOST=127.0.0.1

# ── 存储 ────────────────────────────────────────────────
# 业务库（SQLite）
DATABASE_PATH=data/atlas.db

# ── 模型 ────────────────────────────────────────────────
# 一个 Base URL + 一个 Key + 一个模型，就这三样。
# ⚠️ **换供应商只改这三行**，不改代码 —— 四家国产模型全都提供 Anthropic 兼容端点：
#   智谱    https://open.bigmodel.cn/api/anthropic        glm-5.3
#   MiniMax https://api.minimaxi.com/anthropic            MiniMax-M3
#   DeepSeek https://api.deepseek.com/anthropic            deepseek-v4-pro
#   千问    https://dashscope.aliyuncs.com/apps/anthropic  qwen3.8-max
#   ⚠️ MiniMax 直连不稳定（DNS 解析到保留段），需要走代理
LLM_BASE_URL=https://open.bigmodel.cn/api/anthropic
LLM_API_KEY=
LLM_MODEL=glm-5.3

# 备用模型（**留空 = 没有兜底**）；主模型失败时切（仅限还没吐字时）
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# 推理预算（默认 1024 = 开，0 = 关）。⚠️ Anthropic 要求 LLM_MAX_TOKENS > 这个值
LLM_THINKING_BUDGET=1024
# 单次输出上限
LLM_MAX_TOKENS=8192
# 采样温度
LLM_TEMPERATURE=1

# ── MCP ─────────────────────────────────────────────────
# MCP server 列表放这个文件（列表型配置不适合塞 .env）
MCP_CONFIG_PATH=data/mcp.json

# ── 通用配置 ────────────────────────────────────────────
# 界面语言
SYSTEM_LANGUAGE=zh-CN
# 时区（cron 任务按它判断「今天 9 点」）
TIMEZONE=Asia/Shanghai
# 单轮工具调用步数上限
MAX_TOOL_STEPS=5
# 工具统一超时（毫秒）
TOOL_TIMEOUT_MS=30000
# 允许并行工具调用
MULTI_TOOL_CALLS=true
# 长期记忆总开关
MEMORY_ENABLED=true
# 按相关度排序召回
MEMORY_RELEVANCE_ENABLED=true
# 每轮召回条数
MEMORY_TOP_K=8
# 召回内容的 token 预算
MEMORY_TOKEN_BUDGET=2000
# MEMORY.md 字符上限（超了不自动压缩，只报告）
MEMORY_MAX_CHARS=2200
# USER.md 字符上限
USER_MAX_CHARS=1375
# 会话摘要压缩开关
SUMMARY_ENABLED=true
# 摘要的 token 预算
SUMMARY_TOKEN_BUDGET=2000
# 工具输出截断长度（字符）
TOOL_OUTPUT_MAX_CHARS=4000
# 截断策略：head 保头部 | tail 保尾部（shell 用 tail，错误信息在尾部）
TOOL_OUTPUT_TRUNCATE=tail
# 同一个工具连续调用几次就停（模型陷入循环时的唯一刹车）
SAME_TOOL_REPEAT_LIMIT=2
# 联网搜索后端（SearXNG 兼容，如 http://127.0.0.1:8888/search）；留空 = 不提供 web_search 工具
WEB_SEARCH_URL=
# 会话保留天数（超期的会话连同消息一起清掉；收藏的会话不清）
SESSION_RETENTION_DAYS=90

# ── 成本 ────────────────────────────────────────────────
# 月度 token 预算
MONTHLY_TOKEN_BUDGET=200000
# 超预算是否硬拦（默认只告警）
COST_BUDGET_BLOCK=false
# 告警比例（0~1）
WARN_RATIO=0.8

# ── 安全 ────────────────────────────────────────────────
# 允许 HTTP 工具指向私网 / 回环（默认禁止）
ALLOW_PRIVATE_EGRESS=false
# Shell 工具总开关（关掉 = 整个 shell 能力不可用）
SHELL_ENABLED=true
# 确认档位：none | normal | high（低于工具敏感档时不弹确认）
TOOL_CONFIRM_LEVEL=high

# ── 编排 ────────────────────────────────────────────────
# 每轮最多给模型几个工具（按相关度裁剪）
MAX_TOOLS_PER_TURN=12
# 并行子代理上限
SUBAGENT_MAX_CONCURRENCY=3
# 单个子代理的工具步数上限
SUBAGENT_MAX_STEPS=8
# 定时任务总开关
CRON_ENABLED=true
# 技能自动沉淀总开关
SKILL_AUTOCREATE_ENABLED=true
# 沉淀技能所需的最少工具调用次数（闲聊不沉淀）
SKILL_MIN_TOOL_CALLS=5
# 每轮最多注入几个技能（按相关度取前 N）
SKILL_TOP_K=3
# 注入技能说明的 token 预算（超了就不注入下一条）
SKILL_TOKEN_BUDGET=2000
# 注入系统提示词的 AGENTS.md 字符上限（超了截断，标注「已截断」）
AGENTS_MAX_CHARS=6000

# ── 浏览器 ──────────────────────────────────────────────
# 浏览器能力总开关（关掉就不注册 browser 工具）
BROWSER_ENABLED=true
# 浏览器允许访问的域名白名单（逗号分隔，留空 = 不限域名；*.example.com 也认）
BROWSER_ALLOWED_DOMAINS=

# ── 日志 ────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=info
